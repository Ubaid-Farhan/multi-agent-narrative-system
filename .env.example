# Primary LLM (Gemini)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-flash-latest

# Optional fallback LLM (OpenAI) - used only if Gemini call fails
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Admin panel (/admin) password — admin panel is disabled if empty
ADMIN_PASSWORD=
