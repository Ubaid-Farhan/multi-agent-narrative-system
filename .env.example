# Primary LLM (Gemini)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional fallback LLM (OpenAI) - used only if Gemini call fails
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Admin panel (/admin) password — admin panel is disabled if empty
ADMIN_PASSWORD=12345

# Postgres (e.g. Neon) — completed stories are saved and replayed when the LLM is unavailable.
# Leave empty to run without saving stories.
DATABASE_URL=
# Seconds between turns when replaying a saved story
REPLAY_TURN_DELAY=2.5

# "New with AI" scenario generator (admin panel) — self-hosted gpt-oss (OpenAI-compatible server)
GPT_OSS_BASE_URL=
GPT_OSS_MODEL=gpt-oss-120b
GPT_OSS_API_KEY=
GPT_OSS_REASONING_EFFORT=medium
# Used only if the gpt-oss server is down (separate models so story quota is not used). No paid OpenAI.
SCENARIO_GEMINI_MODEL=gemini-3.5-flash
SCENARIO_GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional tuning (defaults shown)
# GPT_OSS_MAX_TOKENS=12000
# GPT_OSS_TIMEOUT=600
# SCENARIO_GEN_PARALLEL=3

# Store every LLM prompt/response of each story run (admin → Stories → LLM prompts)
LLM_LOG_ENABLED=true
LLM_LOG_RETENTION_DAYS=30

# AI images for characters and scene backgrounds (admin → "New with AI" and "Generate with AI" buttons).
# Cloudflare Workers AI, FLUX.1 [schnell] (open weights). Free: 10,000 neurons/day ≈ 170 images.
# Token: dash.cloudflare.com → My Profile → API Tokens → Create Token → "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional (defaults shown)
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CF_IMAGE_STEPS=6
# IMAGE_STYLE=semi-realistic digital illustration, cinematic lighting, rich detail, warm colour grading, consistent graphic-novel art style
